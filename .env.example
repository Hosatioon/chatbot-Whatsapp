OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# Catálogo enviado automáticamente después del saludo
CATALOG_URL=https://drive.google.com/file/d/.../view

# Auth.js (NextAuth v5) — generá uno nuevo con: openssl rand -base64 32
AUTH_SECRET=cambiame-por-un-secreto-fuerte
AUTH_URL=http://localhost:3000

# Multi-tenant: tenant_id que usa el proceso del bot (cada bot/whatsapp = 1 tenant)
BOT_TENANT_ID=1

# Rate limiting de mensajes entrantes (por teléfono) funciona para evitar spam y limitar el uso excesivo de la API de OpenRouter por usuario
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_DUPLICATE_THRESHOLD=3
RATE_LIMIT_DUPLICATE_WINDOW_SEC=60

# Token opcional para monitoreo externo del endpoint /api/health
# Si está definido, los monitores (UptimeRobot, etc) pueden mandar:
#   curl -H "x-health-token: <TOKEN>" https://dominio/api/health
# Sin el token, /api/health solo responde a super-admins autenticados.
# Generá uno nuevo con: openssl rand -base64 32
HEALTH_CHECK_TOKEN=
