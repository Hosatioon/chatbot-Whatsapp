# ============================================================
# MONDRES - Variables de Entorno para Producción
# ============================================================
#
# Copiar este archivo a .env.production y completar los valores.
#
# NOTA: estas variables son para la arquitectura FUTURA con Postgres
# (docker-compose.prod.yml), que todavía no está lista para usarse
# (ver el aviso al inicio de ese archivo). Para lanzar hoy, usá
# .env.local + .env.example junto con docker-compose.yml.
#
# ============================================================

# ------------------------------------------------------------
# Base de Datos
# ------------------------------------------------------------
# Debe coincidir con POSTGRES_PASSWORD que le pasás a docker-compose.prod.yml
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
DATABASE_URL=postgresql://mondrex:YOUR_SECURE_PASSWORD@postgres:5432/mondrex

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------
# OpenRouter (LLM)
# ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# Único correo autorizado para ver tokens, costos y presupuestos internos
SUPER_ADMIN_EMAIL=hosatioon@gmail.com

# Mensajes recientes enviados al modelo (4-15; menor = menor costo)
LLM_HISTORY_MESSAGES=10

# Catálogo enviado automáticamente después del saludo
CATALOG_URL=https://drive.google.com/file/d/.../view

# ------------------------------------------------------------
# Auth.js (NextAuth v5)
# ------------------------------------------------------------
# Generá uno nuevo con: openssl rand -base64 32
AUTH_SECRET=cambiame-por-un-secreto-fuerte
AUTH_URL=https://tu-dominio.com

# URL pública de la app (para OpenRouter HTTP-Referer)
APP_URL=https://tu-dominio.com

# ------------------------------------------------------------
# Presupuestos y límites de IA
# ------------------------------------------------------------
LLM_MAX_TOKENS=350
LLM_UNKNOWN_MODEL_INPUT_PRICE_USD_PER_MILLION=1
LLM_UNKNOWN_MODEL_OUTPUT_PRICE_USD_PER_MILLION=4
LLM_DAILY_BUDGET_USD=1.0
LLM_MONTHLY_BUDGET_USD=25.0
LLM_GLOBAL_DAILY_BUDGET_USD=10.0

# ------------------------------------------------------------
# Rate limiting de mensajes entrantes (por teléfono)
# ------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_DUPLICATE_THRESHOLD=3
RATE_LIMIT_DUPLICATE_WINDOW_SEC=60

# ------------------------------------------------------------
# Monitoreo externo
# ------------------------------------------------------------
# Token opcional para /api/health (UptimeRobot, etc). Generá con:
# openssl rand -base64 32
HEALTH_CHECK_TOKEN=

# Webhook de Discord/Slack para alertas de desconexión del bot
ALERT_WEBHOOK_URL=
